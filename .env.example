# Copy to .env.production.local (gitignored) to override the public defaults in .env.production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=spacecraft-5f703
# Optional: Firestore emulator instead of the live project, e.g. http://127.0.0.1:8080/v1
# VITE_FIRESTORE_URL=

# Optional TURN relay so co-op works when both phones are on mobile data (carrier CGNAT).
# Either a credentials URL returning an RTCIceServer[] (fetched in the browser), e.g. Metered:
# VITE_TURN_CREDENTIALS_URL=https://<app>.metered.live/api/v1/turn/credentials?apiKey=<key>
# …or static TURN servers + credentials:
# VITE_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
# …or a full JSON array: VITE_ICE_SERVERS=[{"urls":"turn:…","username":"…","credential":"…"}]
