# Public Firebase web config for the global Firestore leaderboard (not secrets: they ship in the
# JS bundle; firestore.rules protects the data). Override in .env.production.local (gitignored)
# or via environment variables. See README "Highscores with Firebase".
VITE_FIREBASE_API_KEY=AIzaSyCL18gL1QPwT64smgyOLMSNqS45P_eVasU
VITE_FIREBASE_PROJECT_ID=spacecraft-5f703

# TURN relay (Metered "Open Relay", free tier) so co-op works when both phones are on mobile data
# (carrier CGNAT). Public on purpose: browser-side TURN credentials always ship in the bundle.
# Google/Cloudflare STUN are always added in code (packages/client/src/net/ice.ts).
VITE_ICE_SERVERS=[{"urls":"stun:stun.relay.metered.ca:80"},{"urls":["turn:global.relay.metered.ca:80","turn:global.relay.metered.ca:80?transport=tcp","turn:global.relay.metered.ca:443","turns:global.relay.metered.ca:443?transport=tcp"],"username":"92103cc0459713eda40b088e","credential":"e6tOqa8+miPM2GJr"}]
