  },
  "devDependencies": {
    "@sms/shared": "*",
    "@types/node": "^20.14.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0"
  }
